---
import { fetchData } from "@/lib/fetchData";
import Layout from "@/layouts/Layout.astro";
import { StructuredText } from "@datocms/astro/StructuredText";
import { format } from "date-fns";
import "@/styles/globals.css";
import { Seo } from "@datocms/astro/Seo";

interface MetaTag {
  attributes: Record<string, string>;
  content: string;
  tag: string;
}

interface PageRecord {
  seo: MetaTag[];
  slug: string;
  pageHeadline: string;
  lastUpdated: string;
  pageText: {
    value: any;
  };
}

const slug = Astro.params.slug;

if (!slug) {
  return Astro.rewrite("/404");
}

const data = await fetchData<{
  page: PageRecord | null;
  site: {
    favicon: MetaTag[];
  };
}>(
  `
  query PageBySlug($slug: String!) {
    page(filter: { slug: { eq: $slug } }) {
      seo: _seoMetaTags {
        attributes
        content
        tag
      }
      slug
      lastUpdated
      pageHeadline
      pageText {
        value
      }
    }
    site: _site {
      favicon: faviconMetaTags {
        attributes
        content
        tag
      }
    }
  }
  `,
  { slug },
);

if (!data.page) {
  return Astro.rewrite("/404");
}

Astro.response.headers.set("Cache-Control", "no-store");

const { seo, pageHeadline, lastUpdated, pageText } = data.page;
const favicon = data.site.favicon;
const formattedDate = lastUpdated ? format(new Date(lastUpdated), "MMMM dd, yyyy") : "";
---

<Seo data={[...seo, ...favicon]} />

<Layout>
  <div class="space-y-5 mt-16">
    <section>
      <h1 class="text-2xl md:text-4xl font-semibold">{pageHeadline}</h1>
      <div class="mt-6">
        {
          formattedDate && (
            <>
              <p class="text-sm">Last updated</p>
              <p class="text-base">{formattedDate}</p>
            </>
          )
        }
      </div>
      <hr class="border-baseLightGray w-40 mt-4" />
    </section>

    <div class="prose">
      <StructuredText data={pageText.value} />
    </div>
  </div>
</Layout>
