---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Launch from "@/components/sections/Launch/index.astro";
import Sparkly from "@/components/sections/Sparkly/index.astro";
import Show from "@/components/sections/Show/index.astro";
import Season from "@/components/sections/Season/index.astro";
