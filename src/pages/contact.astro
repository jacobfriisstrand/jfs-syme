---
import { fetchData } from "@/lib/fetchData";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Contact from "@/components/sections/Contact/index.astro";
import Footer from "@/components/sections/Footer/index.astro";
import "@/styles/globals.css";

interface FetchedData {
  contact: {
    contactLinkName: string;
    contactEmail: string;
    pressLinkName: string;
    pressEmail: string;
  };
}

const data = await fetchData<FetchedData>(`{
  contact: generalInfo {
    contactLinkName
    contactEmail
    pressLinkName
    pressEmail
  }
}`);

Astro.response.headers.set("Cache-Control", "no-store");
---

<Layout fullBleed title="Contact" description="Request an introduction.">
  <Header overlay />
  <Contact contact={data.contact} />
  <Footer />
</Layout>
