---
import { Seo } from "@datocms/astro/Seo";
import { fetchData } from "../lib/fetchData";
import Layout from "@/layouts/Layout.astro";
import Cover from "@/components/sections/Cover/index.astro";
import Partners from "@/components/sections/Partners/index.astro";
import Overview from "@/components/sections/Overview/index.astro";
import Stills from "@/components/sections/Stills/index.astro";
import Partner from "@/components/sections/Partner/index.astro";
import Footer from "@/components/sections/Footer/index.astro";
import Header from "@/components/Header.astro";
import "@/styles/globals.css";

interface MetaTag {
  attributes: Record<string, string>;
  content: string;
  tag: string;
}

interface FetchedData {
  page: {
    seo: MetaTag[];
  };
  site: {
    favicon: MetaTag[];
  };
}

const data = await fetchData<FetchedData>(`{
  page: landingPage {
    seo: _seoMetaTags {
      attributes
      content
      tag
    }
  }
  site: _site {
    favicon: faviconMetaTags {
      attributes
      content
      tag
    }
  }
}`);
---

<Seo data={[...data.page.seo, ...data.site.favicon]} />

<Layout fullBleed>
  <Header overlay />
  <Cover />
  <Partners />
  <Overview />
  <Stills />
  <Partner />
  <Footer />
</Layout>
