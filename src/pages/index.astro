---
import { Seo } from "@datocms/astro/Seo";
import { fetchData } from "../lib/fetchData";
import Layout from "@/layouts/Layout.astro";
import Cover from "@/components/sections/Cover/index.astro";
import Partners from "@/components/sections/Partners/index.astro";
import Mobile from "@/components/sections/Mobile/index.astro";
import Web from "@/components/sections/Web/index.astro";
import Problem from "@/components/sections/Problem/index.astro";
import Market from "@/components/sections/Market/index.astro";
import Offer from "@/components/sections/Offer/index.astro";
import Numbers from "@/components/sections/Numbers/index.astro";
import Clicks from "@/components/sections/Clicks/index.astro";
import Partner from "@/components/sections/Partner/index.astro";
import Launch from "@/components/sections/Launch/index.astro";
import Footer from "@/components/sections/Footer/index.astro";
import Header from "@/components/Header.astro";
import "@/styles/globals.css";

interface MetaTag {
  attributes: Record<string, string>;
  content: string;
  tag: string;
}

interface FetchedData {
  page: {
    seo: MetaTag[];
  };
  site: {
    favicon: MetaTag[];
  };
}

const data = await fetchData<FetchedData>(`{
  page: landingPage {
    seo: _seoMetaTags {
      attributes
      content
      tag
    }
  }
  site: _site {
    favicon: faviconMetaTags {
      attributes
      content
      tag
    }
  }
}`);
---

<Seo data={[...data.page.seo, ...data.site.favicon]} />

<link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
<link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  slot="head"
  href="https://fonts.googleapis.com/css2?family=Arimo:wght@700&family=DM+Sans:opsz,wght@9..40,400;9..40,700&family=Fira+Code:wght@300;400&family=IBM+Plex+Mono&family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,600;0,14..32,700;1,14..32,400&family=Libre+Baskerville:ital,wght@1,400&display=swap"
  rel="stylesheet"
/>

<Layout fullBleed>
  <Header />
  <Cover />
  <Partners />
  <Mobile />
  <Web />
  <Problem />
  <Market />
  <Offer />
  <Numbers />
  <Clicks />
  <Launch />
  <Partner />
  <Footer />
</Layout>
