---
import { Image } from "astro:assets";
import logo from "@/assets/forma-logo.png";
import HeaderMenu from "@/components/HeaderMenu.tsx";

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const links = [
  { href: "/case-studies", label: "CASE STUDIES" },
  { href: "/companies", label: "COMPANIES" },
  { href: "/influencers", label: "INFLUENCERS" },
  { href: "/prices", label: "PRICES" },
  { href: "/contact", label: "CONTACT" },
];

const current = Astro.url.pathname.replace(/\/$/, "") || "/";

const itemClass =
  "eyebrow m-0 whitespace-nowrap border-0 bg-transparent px-0 py-2 text-left no-underline transition-colors hover:text-ink focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-inkMuted min-[1200px]:p-0";

const loginClass = `${itemClass} cursor-pointer underline underline-offset-4`;
---

<header
  id="site-header"
  class:list={[
    "group sticky top-0 z-50 bg-baseLight font-inter text-ink antialiased min-[1200px]:transition-[height,padding,margin,background-color] min-[1200px]:duration-300 min-[1200px]:ease-out min-[1200px]:motion-reduce:transition-none min-[1200px]:[--header-pill:calc(var(--header-bar)+2rem)] min-[1200px]:[&.is-compact]:h-[calc(0.75rem+var(--header-pill))] min-[1200px]:[&.is-compact]:bg-transparent min-[1200px]:[&.is-compact]:pb-0 min-[1200px]:[&.is-compact]:pt-3",
    !overlay && "min-[1200px]:pb-px min-[1200px]:pt-[calc(var(--board-w)*0.0024+1px)]",
    overlay &&
      "min-[1200px]:-mb-[var(--header-height)] min-[1200px]:h-[var(--header-height)] min-[1200px]:pb-[var(--header-below)] min-[1200px]:pt-[var(--header-offset)] min-[1200px]:[&.is-compact]:-mb-[calc(0.75rem+var(--header-pill))]",
  ]}
>
  <div
    class:list={[
      "relative mx-auto flex h-14 items-center justify-between gap-4 px-6 min-[1200px]:h-[var(--header-bar)] min-[1200px]:w-[var(--board-w)] min-[1200px]:border min-[1200px]:border-transparent min-[1200px]:bg-baseLight min-[1200px]:px-0 min-[1200px]:[container-type:inline-size] min-[1200px]:transition-[width,max-width,height,border-radius,border-color,background-color,box-shadow] min-[1200px]:duration-300 min-[1200px]:ease-out min-[1200px]:motion-reduce:transition-none min-[1200px]:group-[.is-compact]:h-[var(--header-pill)] min-[1200px]:group-[.is-compact]:max-w-[calc(100vw-10rem)] min-[1200px]:group-[.is-compact]:rounded-full min-[1200px]:group-[.is-compact]:border-ink/10 min-[1200px]:group-[.is-compact]:bg-baseLight min-[1200px]:group-[.is-compact]:shadow-header",
    ]}
  >
    <a
      href="/"
      class:list={[
        "block w-20 shrink-0 min-[1200px]:absolute min-[1200px]:left-[4.0213%] min-[1200px]:top-0 min-[1200px]:z-10 min-[1200px]:flex min-[1200px]:h-full min-[1200px]:w-[8.3968%] min-[1200px]:items-center min-[1200px]:transition-[left,top,height,transform] min-[1200px]:duration-300 min-[1200px]:ease-out min-[1200px]:motion-reduce:transition-none min-[1200px]:group-[.is-compact]:left-[6%]",
      ]}
      aria-label="Forma"
    >
      <Image
        src={logo}
        alt=""
        loading="eager"
        class="block h-auto w-full object-contain object-left min-[1200px]:text-[length:var(--eyebrow-size)] min-[1200px]:translate-y-[calc(-27.2727%+0.3705em)]"
      />
    </a>
    <HeaderMenu client:load menuId="login-menu" />
    <nav
      id="login-menu"
      class:list={[
        "absolute inset-x-0 top-full z-50 m-0 hidden max-h-[calc(100dvh-3.5rem)] flex-col items-start gap-1 overflow-y-auto border-t border-ink/10 bg-baseLight px-6 py-4 group-[.is-open]:flex min-[1200px]:inset-x-auto min-[1200px]:left-[15%] min-[1200px]:right-[4.1163%] min-[1200px]:top-0 min-[1200px]:z-auto min-[1200px]:flex min-[1200px]:h-full min-[1200px]:max-h-none min-[1200px]:flex-row min-[1200px]:items-center min-[1200px]:justify-between min-[1200px]:gap-3 min-[1200px]:overflow-visible min-[1200px]:border-0 min-[1200px]:bg-transparent min-[1200px]:p-0 min-[1200px]:transition-[left,right,top,height,transform] min-[1200px]:duration-300 min-[1200px]:ease-out min-[1200px]:motion-reduce:transition-none min-[1200px]:group-[.is-compact]:left-[calc(6%+8.3968%+1.5rem)] min-[1200px]:group-[.is-compact]:right-[4%]",
      ]}
      aria-label="Primary"
    >
      <div class="flex flex-col items-start gap-1 min-[1200px]:flex-row min-[1200px]:items-center min-[1200px]:gap-[1em]">
        {
          links.map((link) => (
            <a
              class:list={[itemClass, current === link.href && "text-ink underline underline-offset-4"]}
              href={link.href}
              aria-current={current === link.href ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </div>
      <div class="mt-3 flex flex-col items-start gap-1 border-t border-ink/10 pt-3 min-[1200px]:mt-0 min-[1200px]:flex-row min-[1200px]:items-center min-[1200px]:gap-[1.2em] min-[1200px]:border-0 min-[1200px]:pt-0">
        <button type="button" class={loginClass}>
          LOG IN - INFLUENCERS
        </button>
        <button type="button" class={loginClass}>
          LOG IN - COMPANIES
        </button>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const target = document.getElementById("cover") ?? document.getElementById("header-sentinel");
  const desktop = window.matchMedia("(min-width: 1200px)");

  if (header && target) {
    const observer = new IntersectionObserver(([entry]) => {
      if (!desktop.matches) return;
      header.classList.toggle("is-compact", !entry.isIntersecting);
    });

    const sync = () => {
      if (desktop.matches) {
        observer.observe(target);
        return;
      }

      observer.disconnect();
      header.classList.remove("is-compact");
    };

    sync();
    desktop.addEventListener("change", sync);
  }
</script>
