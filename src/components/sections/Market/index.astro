---
import { Image } from "astro:assets";
import caseStudy from "@/assets/market/case-study.png";

interface Stat {
  value: string;
  text: string;
  source: string;
  ruleTop: string;
  valueTop: string;
  textTop: string;
  sourceTop: string;
}

const stats: Stat[] = [
  {
    value: "61%",
    text: "of travelers have booked a hotel after seeing it on Instagram.",
    source: "EXPEDIA GROUP",
    ruleTop: "min-[1200px]:top-[43.787%]",
    valueTop: "min-[1200px]:top-[47.49%]",
    textTop: "min-[1200px]:top-[49.99%]",
    sourceTop: "min-[1200px]:top-[53.25%]",
  },
  {
    value: "60%",
    text: "say influencer content consistently outperforms brand-created content.",
    source: "INFLUENCER MARKETING HUB",
    ruleTop: "min-[1200px]:top-[59.566%]",
    valueTop: "min-[1200px]:top-[62.82%]",
    textTop: "min-[1200px]:top-[65.63%]",
    sourceTop: "min-[1200px]:top-[68.78%]",
  },
  {
    value: "8x",
    text: "average return from restaurant influencer collaborations.",
    source: "SEVENROOMS",
    ruleTop: "min-[1200px]:top-[73.965%]",
    valueTop: "min-[1200px]:top-[77.4%]",
    textTop: "min-[1200px]:top-[80.09%]",
    sourceTop: "min-[1200px]:top-[83.31%]",
  },
];
---

<div class="bg-baseLight min-[1200px]:grid min-[1200px]:h-dvh min-[1200px]:w-full min-[1200px]:place-items-center min-[1200px]:overflow-hidden min-[1200px]:[container-type:size]">
  <section
    class="bg-baseLight px-6 py-16 font-inter text-ink antialiased md:px-10 md:py-20 min-[1200px]:relative min-[1200px]:aspect-[900/507] min-[1200px]:w-[min(100cqw,calc(100cqh*1.775148))] min-[1200px]:overflow-hidden min-[1200px]:px-0 min-[1200px]:py-0 min-[1200px]:[container-type:size]"
    aria-label="Why it matters"
  >
    <div class="flex flex-col gap-8 min-[1200px]:contents">
      <p class="eyebrow m-0 min-[1200px]:absolute min-[1200px]:right-[4.0747%] min-[1200px]:top-[4.9312%] min-[1200px]:whitespace-nowrap">
        THE MARKET HAS MOVED
      </p>

      <div class="flex flex-col gap-10 md:grid md:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] md:items-start md:gap-12 min-[1200px]:contents">
        <div class="flex min-w-0 flex-col gap-8 min-[1200px]:contents">
          <h2 class="headline-row m-0 min-[1200px]:absolute min-[1200px]:left-[4.02%] min-[1200px]:top-[24.83%] min-[1200px]:whitespace-nowrap">
            <span class="headline">Why it matters</span>
            <span class="sr-only"> </span>
            <span class="headline-italic">now.</span>
          </h2>

          <p class="body m-0 min-[1200px]:absolute min-[1200px]:left-[4.02%] min-[1200px]:top-[37.06%] min-[1200px]:whitespace-nowrap">
            Traveler, hospitality, and lifestyle decisions are increasingly made on the feeds of
            <br class="hidden min-[1200px]:inline" />
            people they trust - not on the feeds of brands.
          </p>

          <div class="flex flex-col min-[1200px]:contents">
            {
              stats.map((stat) => (
                <article class="grid grid-cols-[4.75rem_minmax(0,1fr)] gap-x-4 gap-y-1 border-t border-baseLightGray py-5 min-[1200px]:contents">
                  <div
                    class:list={[
                      "hidden min-[1200px]:absolute min-[1200px]:left-[3.6%] min-[1200px]:block min-[1200px]:h-[calc(1/900*100cqw)] min-[1200px]:w-[57.5%] min-[1200px]:bg-baseLightGray",
                      stat.ruleTop,
                    ]}
                  />
                  <p class:list={["stat-small col-start-1 row-span-2 m-0 self-start min-[1200px]:absolute min-[1200px]:left-[6.06%] min-[1200px]:whitespace-nowrap", stat.valueTop]}>
                    {stat.value}
                  </p>
                  <p class:list={["copy col-start-2 m-0 text-ink min-[1200px]:absolute min-[1200px]:left-[18.52%] min-[1200px]:whitespace-nowrap", stat.textTop]}>
                    {stat.text}
                  </p>
                  <p class:list={["caption col-start-2 m-0 text-ink min-[1200px]:absolute min-[1200px]:left-[18.52%] min-[1200px]:whitespace-nowrap", stat.sourceTop]}>
                    {stat.source}
                  </p>
                </article>
              ))
            }
          </div>
        </div>

        <div class="flex flex-col gap-4 overflow-hidden rounded-[var(--radius-panel)] bg-panel p-4 text-baseLight md:p-6 min-[1200px]:absolute min-[1200px]:left-[63.8778%] min-[1200px]:top-[18.7377%] min-[1200px]:h-[70.8679%] min-[1200px]:w-[33.7444%] min-[1200px]:gap-0 min-[1200px]:p-0">
          <Image
            src={caseStudy}
            alt="Hands wearing gold rings holding a drink at the Camille Brinch jewellery launch"
            class="pointer-events-none aspect-[4/5] w-full max-w-none rounded-[var(--radius-media)] object-cover min-[1200px]:absolute min-[1200px]:left-[6.53%] min-[1200px]:top-[6.73%] min-[1200px]:aspect-auto min-[1200px]:h-[64.6%] min-[1200px]:w-[86.03%]"
          />

          <p class="caption m-0 text-baseLight min-[1200px]:absolute min-[1200px]:left-[7.24%] min-[1200px]:top-[73.03%] min-[1200px]:whitespace-nowrap">
            CASE STUDY – CAMILLE BRINCH JEWELLERY
          </p>

          <p class="copy m-0 text-baseLight min-[1200px]:absolute min-[1200px]:left-[7.24%] min-[1200px]:top-[76.9%] min-[1200px]:whitespace-nowrap">
            Intimate dinner & afterparty of the Sparkly
            <br class="hidden min-[1200px]:inline" />
            Collection launch - handpicked guest list, strong
            <br class="hidden min-[1200px]:inline" />
            brand alignment, cohesive content.
          </p>
        </div>
      </div>

      <p class="eyebrow m-0 min-[1200px]:absolute min-[1200px]:right-[4.0747%] min-[1200px]:top-[93.4876%] min-[1200px]:whitespace-nowrap">
        EXTERNAL RESEARCH, 2025-26
      </p>
    </div>
  </section>
</div>
