---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import pill from "@/assets/mobile/explore-pill.png";
import screenWelcome from "@/assets/mobile/screen-welcome.png";
import screenOffers from "@/assets/mobile/screen-offers.png";
import screenDetails from "@/assets/mobile/screen-details.png";
import frameLeft from "@/assets/mobile/frame-left.svg?url";
import frameMid from "@/assets/mobile/frame-mid.svg?url";
import frameRight from "@/assets/mobile/frame-right.svg?url";
import shellLeft from "@/assets/mobile/shell-left.svg?url";
import shellMid from "@/assets/mobile/shell-mid.svg?url";
import shellRight from "@/assets/mobile/shell-right.svg?url";
import islandLeft from "@/assets/mobile/island-left.svg?url";
import islandMid from "@/assets/mobile/island-mid.svg?url";
import islandRight from "@/assets/mobile/island-right.svg?url";
import cameraLeft from "@/assets/mobile/camera-left.svg?url";
import cameraMid from "@/assets/mobile/camera-mid.svg?url";
import cameraRight from "@/assets/mobile/camera-right.svg?url";
import sideLeftA from "@/assets/mobile/side-left-a.svg?url";
import sideLeftB from "@/assets/mobile/side-left-b.svg?url";
import sideLeftC from "@/assets/mobile/side-left-c.svg?url";
import sideLeftD from "@/assets/mobile/side-left-d.svg?url";
import sideMidA from "@/assets/mobile/side-mid-a.svg?url";
import sideMidB from "@/assets/mobile/side-mid-b.svg?url";
import sideMidC from "@/assets/mobile/side-mid-c.svg?url";
import sideMidD from "@/assets/mobile/side-mid-d.svg?url";
import sideRightA from "@/assets/mobile/side-right-a.svg?url";
import sideRightB from "@/assets/mobile/side-right-b.svg?url";
import sideRightC from "@/assets/mobile/side-right-c.svg?url";
import sideRightD from "@/assets/mobile/side-right-d.svg?url";

interface Graphic {
  src: string;
  width: number;
  height: number;
  class: string;
}

interface Phone {
  frame: Graphic;
  screen: ImageMetadata;
  screenAlt: string;
  screenClass: string;
  chrome: Graphic[];
  shell: Graphic;
}

const graphicClass = "pointer-events-none absolute max-w-none";

const phones: Phone[] = [
  {
    frame: {
      src: frameLeft,
      width: 163.464,
      height: 333.792,
      class: "left-[35.5%] top-[19.82%] h-[65.8367%] w-[18.1627%]",
    },
    screen: screenWelcome,
    screenAlt: "Forma app sign-in screen",
    screenClass: "left-[36.45%] top-[21.4%] h-[62.76%] w-[16.27%]",
    chrome: [
      { src: islandLeft, width: 22.632, height: 2.808, class: "left-[43.21%] top-[22.04%] h-[0.5538%] w-[2.5147%]" },
      { src: cameraLeft, width: 4.128, height: 4.152, class: "left-[46.53%] top-[21.91%] h-[0.8189%] w-[0.4587%]" },
      { src: sideLeftA, width: 1.824, height: 13.872, class: "left-[35.11%] top-[28.3%] h-[2.7361%] w-[0.2027%]" },
      { src: sideLeftB, width: 1.824, height: 25.032, class: "left-[35.11%] top-[33.07%] h-[4.9373%] w-[0.2027%]" },
      { src: sideLeftC, width: 1.824, height: 25.104, class: "left-[35.11%] top-[39.08%] h-[4.9515%] w-[0.2027%]" },
      { src: sideLeftD, width: 2.016, height: 41.256, class: "left-[53.82%] top-[34.6%] h-[8.1373%] w-[0.224%]" },
    ],
    shell: {
      src: shellLeft,
      width: 166.776,
      height: 337.104,
      class: "left-[35.31%] top-[19.5%] h-[66.4899%] w-[18.5307%]",
    },
  },
  {
    frame: {
      src: frameMid,
      width: 163.464,
      height: 333.792,
      class: "left-[56.69%] top-[19.82%] h-[65.8367%] w-[18.1627%]",
    },
    screen: screenOffers,
    screenAlt: "Forma app offers list",
    screenClass: "left-[57.63%] top-[21.5%] h-[62.63%] w-[16.27%]",
    chrome: [
      { src: islandMid, width: 22.632, height: 2.808, class: "left-[64.41%] top-[22.04%] h-[0.5538%] w-[2.5147%]" },
      { src: cameraMid, width: 4.128, height: 4.152, class: "left-[67.73%] top-[21.91%] h-[0.8189%] w-[0.4587%]" },
      { src: sideMidA, width: 1.824, height: 13.872, class: "left-[56.31%] top-[28.3%] h-[2.7361%] w-[0.2027%]" },
      { src: sideMidB, width: 1.824, height: 25.032, class: "left-[56.31%] top-[33.07%] h-[4.9373%] w-[0.2027%]" },
      { src: sideMidC, width: 1.824, height: 25.104, class: "left-[56.31%] top-[39.08%] h-[4.9515%] w-[0.2027%]" },
      { src: sideMidD, width: 1.992, height: 41.256, class: "left-[75.02%] top-[34.6%] h-[8.1373%] w-[0.2213%]" },
    ],
    shell: {
      src: shellMid,
      width: 166.776,
      height: 337.104,
      class: "left-[56.51%] top-[19.5%] h-[66.4899%] w-[18.5307%]",
    },
  },
  {
    frame: {
      src: frameRight,
      width: 163.488,
      height: 333.792,
      class: "left-[77.89%] top-[19.82%] h-[65.8367%] w-[18.1653%]",
    },
    screen: screenDetails,
    screenAlt: "Forma app offer details",
    screenClass: "left-[78.76%] top-[21.5%] h-[62.63%] w-[16.42%]",
    chrome: [
      { src: islandRight, width: 22.632, height: 2.808, class: "left-[85.61%] top-[22.04%] h-[0.5538%] w-[2.5147%]" },
      { src: cameraRight, width: 4.152, height: 4.152, class: "left-[88.92%] top-[21.91%] h-[0.8189%] w-[0.4613%]" },
      { src: sideRightA, width: 1.824, height: 13.872, class: "left-[77.5%] top-[28.3%] h-[2.7361%] w-[0.2027%]" },
      { src: sideRightB, width: 1.824, height: 25.032, class: "left-[77.5%] top-[33.07%] h-[4.9373%] w-[0.2027%]" },
      { src: sideRightC, width: 1.824, height: 25.104, class: "left-[77.5%] top-[39.08%] h-[4.9515%] w-[0.2027%]" },
      { src: sideRightD, width: 1.992, height: 41.256, class: "left-[96.22%] top-[34.6%] h-[8.1373%] w-[0.2213%]" },
    ],
    shell: {
      src: shellRight,
      width: 166.752,
      height: 337.104,
      class: "left-[77.71%] top-[19.5%] h-[66.4899%] w-[18.528%]",
    },
  },
];

const features = [
  { index: "0 1", label: "Browse curated offers from premium partners", top: "top-[74.3%]" },
  { index: "0 2", label: "Apply & confirm in two taps", top: "top-[79.25%]" },
  { index: "0 3", label: "Deliver content directly inside the app", top: "top-[84.31%]" },
];
---

<div class="grid h-dvh w-full place-items-center overflow-hidden bg-[#000] [container-type:size]">
  <section
    class="relative aspect-[900/507] w-[min(100cqw,calc(100cqh*1.775148))] overflow-hidden bg-[#000] font-inter text-[#fff] antialiased [container-type:size]"
    aria-label="Forma on mobile"
  >
    {
      phones.map((phone) => (
        <>
          <Image src={phone.screen} alt={phone.screenAlt} class:list={["pointer-events-none absolute max-w-none object-cover", phone.screenClass]} />
          <img src={phone.frame.src} alt="" width={phone.frame.width} height={phone.frame.height} class:list={[graphicClass, phone.frame.class]} />
          {phone.chrome.map((layer) => (
            <img src={layer.src} alt="" width={layer.width} height={layer.height} class:list={[graphicClass, layer.class]} />
          ))}
          <img src={phone.shell.src} alt="" width={phone.shell.width} height={phone.shell.height} class:list={[graphicClass, phone.shell.class]} />
        </>
      ))
    }

    <p class="eyebrow absolute right-[3.5%] top-[4.62%] m-0 whitespace-nowrap text-[#fff]">
      PRODUCT - MOBILE
    </p>

    <p class="eyebrow absolute left-[4.36%] top-[19.66%] m-0 whitespace-nowrap text-[#fff]">
      FOR PROFILES
    </p>

    <h2 class="m-0">
      <span class="headline absolute left-[3.59%] top-[24.97%] m-0 whitespace-nowrap">FORMA</span>
      <span class="headline-italic absolute left-[3.59%] top-[35.83%] m-0 whitespace-nowrap">on mobile</span>
    </h2>

    <p class="deck absolute left-[3.59%] top-[48.31%] m-0 w-[22.11%] whitespace-nowrap text-[#fff]">
      Discover, apply, and manage<br />
      premium collaborations seamlessly -<br />
      from a single app in your pocket.
    </p>

    <button
      type="button"
      class="absolute left-[3.592%] top-[62.853%] flex h-[7.272%] w-[14.416%] cursor-pointer items-center justify-center border-0 bg-transparent p-0 transition-opacity hover:opacity-80 focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-[#fff]"
    >
      <Image src={pill} alt="" class="pointer-events-none absolute inset-0 h-full w-full max-w-none" />
      <span class="relative font-arimo text-[length:calc(9.5/900*100cqw)] font-bold leading-none tracking-[0.0078em] text-[#000]">
        EXPLORE FORMA
      </span>
    </button>

    {
      features.map((feature) => (
        <p class:list={["absolute left-[3.59%] m-0 flex items-baseline", feature.top]}>
          <span class="w-[2.28cqw] shrink-0 text-[length:calc(5.8/900*100cqw)] font-normal leading-none">{feature.index}</span>
          <span class="whitespace-nowrap text-[length:calc(9.8/900*100cqw)] font-semibold leading-[1.22] tracking-[0.0137em]">{feature.label}</span>
        </p>
      ))
    }

    <p class="eyebrow absolute bottom-[4.26%] right-[3.36%] m-0 whitespace-nowrap text-[#fff]">
      AVAILABLE ON IOS
    </p>
  </section>
</div>
