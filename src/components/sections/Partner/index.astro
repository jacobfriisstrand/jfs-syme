---
const buttonClass =
  "cta-label flex h-12 w-full items-center justify-center rounded-full bg-cta px-6 no-underline transition-colors hover:bg-ctaHover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink min-[1200px]:absolute min-[1200px]:left-[61%] min-[1200px]:h-[calc(30/900*100cqw)] min-[1200px]:w-[17%] min-[1200px]:px-0";
---

<div class="w-full bg-baseLight">
  <section
    class="bg-baseLight px-6 py-16 font-inter text-ink antialiased md:px-10 md:py-20 min-[1200px]:relative min-[1200px]:mx-auto min-[1200px]:aspect-[900/260] min-[1200px]:w-[var(--board-w)] min-[1200px]:overflow-hidden min-[1200px]:px-0 min-[1200px]:py-0 min-[1200px]:[container-type:size]"
    aria-label="Become a partner"
  >
    <div class="flex flex-col gap-8 md:grid md:grid-cols-[minmax(0,1.4fr)_minmax(12rem,18rem)] md:items-center md:gap-12 min-[1200px]:contents">
      <div class="flex min-w-0 flex-col gap-6 min-[1200px]:contents">
        <p class="eyebrow m-0 min-[1200px]:absolute min-[1200px]:right-[3.89%] min-[1200px]:top-[6.9%] min-[1200px]:whitespace-nowrap">
          NEXT STEPS
        </p>

        <h2 class="headline-row m-0 min-[1200px]:absolute min-[1200px]:left-[4.22%] min-[1200px]:top-[18.5%] min-[1200px]:whitespace-nowrap">
          <span class="headline">Become a</span>
          <span class="sr-only"> </span>
          <span class="headline-italic">partner.</span>
        </h2>

        <p class="body m-0 min-[1200px]:absolute min-[1200px]:left-[4.211%] min-[1200px]:top-[50%] min-[1200px]:whitespace-nowrap">
          As a partner on FORMA, your brand gets <span class="font-bold">direct</span>
          <span class="font-bold">access</span> to a curated network of premium
          <br class="hidden min-[1200px]:inline" />
          profiles across hospitality, fashion, beauty, travel, and culture. Launch collaborations in
          <br class="hidden min-[1200px]:inline" />
          minutes, approve the right profiles in a few clicks, and manage everything in one place.
        </p>

        <p class="body m-0 min-[1200px]:absolute min-[1200px]:left-[4.211%] min-[1200px]:top-[73%] min-[1200px]:whitespace-nowrap">
          We are currently onboarding a <span class="font-bold">limited</span>
          <span class="font-bold">number</span> of selected partners.
        </p>
      </div>

      <div class="flex flex-col gap-3 min-[1200px]:contents">
        <a
          class:list={[buttonClass, "min-[1200px]:top-[50%] min-[1200px]:tracking-[0.022em]"]}
          href="https://member.formaintl.com/?view=registration"
          target="_blank"
          rel="noreferrer"
        >
          REGISTER AS A PARTNER
        </a>
        <a
          class:list={[buttonClass, "min-[1200px]:top-[66.2%] min-[1200px]:tracking-[-0.015em]"]}
          href="mailto:sb@formaintl.com?subject=Request%20an%20Introduction%20-%20FORMA"
        >
          REQUEST AN INTRODUCTION
        </a>
      </div>
    </div>
  </section>
</div>
