---
const buttonClass =
  "absolute left-[61%] flex h-[calc(30/900*100cqw)] w-[17%] items-center justify-center rounded-full bg-[#0c0b09] font-arimo text-[length:calc(8.5/900*100cqw)] font-bold leading-none text-[#ffffff] no-underline transition-colors hover:bg-[#2a2926] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1e1e1e]";
---

<div class="w-full bg-baseLight">
  <section
    class="relative aspect-[900/260] w-full overflow-hidden bg-baseLight font-inter text-ink antialiased [container-type:size]"
    aria-label="Become a partner"
  >
    <p
      class="eyebrow absolute right-[3.89%] top-[6.9%] m-0 whitespace-nowrap"
    >
      NEXT STEPS
    </p>

    <h2 class="headline-row absolute left-[4.22%] top-[18.5%] m-0 whitespace-nowrap">
      <span class="headline">Become a</span>
      <span class="sr-only"> </span>
      <span class="headline-italic">partner.</span>
    </h2>

    <p
      class="body absolute left-[4.211%] top-[50%] m-0 whitespace-nowrap"
    >
      As a partner on FORMA, your brand gets <span class="font-bold">direct</span>
      <span class="font-bold">access</span> to a curated network of premium
      <br />
      profiles across hospitality, fashion, beauty, travel, and culture. Launch collaborations in
      <br />
      minutes, approve the right profiles in a few clicks, and manage everything in one place.
    </p>

    <p
      class="body absolute left-[4.211%] top-[73%] m-0 whitespace-nowrap"
    >
      We are currently onboarding a <span class="font-bold">limited</span>
      <span class="font-bold">number</span> of selected partners.
    </p>

    <a
      class:list={[buttonClass, "top-[50%] tracking-[0.022em]"]}
      href="https://member.formaintl.com/?view=registration"
      target="_blank"
      rel="noreferrer"
    >
      REGISTER AS A PARTNER
    </a>
    <a
      class:list={[buttonClass, "top-[66.2%] tracking-[-0.015em]"]}
      href="mailto:sb@formaintl.com?subject=Request%20an%20Introduction%20-%20FORMA"
    >
      REQUEST AN INTRODUCTION
    </a>

  </section>
</div>
