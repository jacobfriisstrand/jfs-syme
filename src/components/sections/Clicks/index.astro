---
import { Image } from "astro:assets";
import arrow from "@/assets/clicks/arrow.png";
import strike from "@/assets/clicks/strike.png";
import suite from "@/assets/clicks/suite.png";
---

<div class="bg-baseLight min-[1200px]:grid min-[1200px]:h-dvh min-[1200px]:w-full min-[1200px]:place-items-center min-[1200px]:overflow-hidden">
  <section
    class="bg-baseLight px-6 py-16 font-inter text-ink antialiased md:px-10 md:py-20 min-[1200px]:relative min-[1200px]:h-[var(--board-h)] min-[1200px]:w-[var(--board-w)] min-[1200px]:overflow-hidden min-[1200px]:px-0 min-[1200px]:py-0 min-[1200px]:[container-type:inline-size]"
    aria-label="From 33 emails to 3 clicks"
  >
    <div class="flex flex-col gap-8 min-[1200px]:contents">
      <p class="eyebrow m-0 min-[1200px]:absolute min-[1200px]:right-[3.411%] min-[1200px]:top-[4.931%] min-[1200px]:whitespace-nowrap">
        CASE STUDY • RADISSON • ISSEI
      </p>

      <div class="flex flex-col gap-10 md:grid md:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] md:items-start md:gap-12 min-[1200px]:contents">
        <div class="flex min-w-0 flex-col gap-6 min-[1200px]:contents">
          <h2 class="m-0 min-[1200px]:contents">
            <span class="display relative m-0 block min-[1200px]:absolute min-[1200px]:left-[10.2444%] min-[1200px]:top-[21.3412%] min-[1200px]:whitespace-nowrap">
              From <span class="relative text-inkFaint">33 Emails<Image src={strike} alt="" class="pointer-events-none absolute left-0 top-1/2 h-[0.35em] w-full -translate-y-1/2 object-fill min-[1200px]:hidden" /></span>
            </span>
            <span class="display m-0 block min-[1200px]:absolute min-[1200px]:left-[16.3928%] min-[1200px]:top-[32.07%] min-[1200px]:whitespace-nowrap">
              3 Clicks.
            </span>
          </h2>

          <Image
            src={arrow}
            alt=""
            class="pointer-events-none absolute left-[4.0222%] top-[35.1874%] hidden h-[8.7179%] w-[11.2444%] max-w-none min-[1200px]:block"
          />
          <Image
            src={strike}
            alt=""
            class="pointer-events-none absolute left-[24.6094%] top-[25.9172%] z-10 hidden h-[7.1006%] w-[28.5889%] max-w-none min-[1200px]:block"
          />

          <p class="body m-0 min-[1200px]:absolute min-[1200px]:left-[4.41%] min-[1200px]:top-[54.9%] min-[1200px]:whitespace-nowrap">
            A previously slow, multi-stakeholder process compressed into a precurated offer.
          </p>

          <p class="body m-0 min-[1200px]:absolute min-[1200px]:left-[4.41%] min-[1200px]:top-[57.86%] min-[1200px]:whitespace-nowrap">
            Created, sent, matched, accepted - all in a few clicks. Influencer Emil Thorup and his
            <br class="hidden min-[1200px]:inline" />
            partner were welcomed by a concierge already briefed on the collaboration.
          </p>

          <p class="body-muted m-0 min-[1200px]:absolute min-[1200px]:left-[4.4%] min-[1200px]:top-[66.647%] min-[1200px]:whitespace-nowrap">
            High-quality content, increased visibility, and bookings - delivered through a simplified,
            <br class="hidden min-[1200px]:inline" />
            repeatable process the team now ships weekly.
          </p>
        </div>

        <div class="flex flex-col gap-4 overflow-hidden rounded-[var(--radius-panel)] bg-panel p-4 text-baseLight md:p-6 min-[1200px]:absolute min-[1200px]:left-[63.8778%] min-[1200px]:top-[18.7377%] min-[1200px]:h-[70.8679%] min-[1200px]:w-[33.7444%] min-[1200px]:gap-0 min-[1200px]:p-0">
          <Image
            src={suite}
            alt="Panorama suite in Copenhagen, with a city view beyond mirrored wall panels"
            class="pointer-events-none aspect-[4/5] w-full max-w-none rounded-[var(--radius-media)] object-cover min-[1200px]:absolute min-[1200px]:left-[6.53%] min-[1200px]:top-[6.73%] min-[1200px]:aspect-auto min-[1200px]:h-[64.6%] min-[1200px]:w-[86.03%]"
          />

          <p class="caption m-0 text-baseLight min-[1200px]:absolute min-[1200px]:left-[7.24%] min-[1200px]:top-[73.03%] min-[1200px]:whitespace-nowrap">
            PANORAMA SUITE - COPENHAGEN
          </p>

          <p class="copy m-0 text-baseLight min-[1200px]:absolute min-[1200px]:left-[7.24%] min-[1200px]:top-[76.9%] min-[1200px]:whitespace-nowrap">
            Stay at Radisson Royal Collection paired with
            <br class="hidden min-[1200px]:inline" />
            dining at Issei - concierge fully aligned on the
            <br class="hidden min-[1200px]:inline" />
            collaboration.
          </p>
        </div>
      </div>
    </div>
  </section>
</div>
