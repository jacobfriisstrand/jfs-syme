---
import { Image } from "astro:assets";
import caseStudy from "@/assets/problem/case-study.png";

interface Problem {
  index: string;
  title: string;
  lines: [string, string];
  ruleTop: string;
  indexTop: string;
  titleTop: string;
  bodyTop: string;
}

const graphicClass = "pointer-events-none absolute max-w-none";

const problems: Problem[] = [
  {
    index: "01",
    title: "Fragmented partnerships.",
    lines: [
      "Collaborations are still managed through DMs, emails, and spreadsheets - creating slow",
      "execution and unnecessary friction.",
    ],
    ruleTop: "top-[46.9132%]",
    indexTop: "top-[49.5661%]",
    titleTop: "top-[48.9546%]",
    bodyTop: "top-[54.0039%]",
  },
  {
    index: "02",
    title: "Wrong audience.",
    lines: [
      "Brands often collaborate with profiles that lack true audience and brand alignment -",
      "eroding ROI.",
    ],
    ruleTop: "top-[61.4694%]",
    indexTop: "top-[64.7535%]",
    titleTop: "top-[64.142%]",
    bodyTop: "top-[69.211%]",
  },
  {
    index: "03",
    title: "No content strategy.",
    lines: [
      "Most collaborations happen without a clear performance or distribution strategy behind",
      "them.",
    ],
    ruleTop: "top-[76.075%]",
    indexTop: "top-[79.8619%]",
    titleTop: "top-[79.2899%]",
    bodyTop: "top-[84.2209%]",
  },
];
---

<div class="grid h-dvh w-full place-items-center overflow-hidden bg-baseLight [container-type:size]">
  <section
    class="relative aspect-[900/507] w-[min(100cqw,calc(100cqh*1.775148))] overflow-hidden bg-baseLight font-inter text-ink antialiased [container-type:size]"
    aria-label="The problem"
  >
    <p class="eyebrow absolute right-[4.0747%] top-[4.9312%] m-0 whitespace-nowrap">
      THE PROBLEM
    </p>

    <h2 class="m-0">
      <span class="headline absolute left-[3.6444%] top-[12.6506%] m-0 whitespace-nowrap">Premium brand</span>
      <span class="headline absolute left-[3.6444%] top-[21.2301%] m-0 whitespace-nowrap">marketing needs</span>
      <span class="headline-italic absolute left-[3.6444%] top-[32.8285%] m-0 whitespace-nowrap">a better way.</span>
    </h2>

    {
      problems.map((problem) => (
        <>
          <div
            class:list={[
              "absolute left-[3.6444%] h-[calc(1/900*100cqw)] w-[57.8333%] bg-baseLightGray",
              problem.ruleTop,
            ]}
          />
          <p
            class:list={[
              "caption absolute left-[4.4778%] m-0 whitespace-nowrap text-ink",
              problem.indexTop,
            ]}
          >
            {problem.index}
          </p>
          <h3
            class:list={[
              "title absolute left-[9.3333%] m-0 whitespace-nowrap",
              problem.titleTop,
            ]}
          >
            {problem.title}
          </h3>
          <p
            class:list={[
              "copy absolute left-[9.3333%] m-0 whitespace-nowrap text-ink/80",
              problem.bodyTop,
            ]}
          >
            {problem.lines[0]}
            <br />
            {problem.lines[1]}
          </p>
        </>
      ))
    }

    <div class="absolute left-[63.8778%] top-[18.7377%] h-[70.8679%] w-[33.7444%] rounded-[calc(12/900*100cqw)] bg-[#10100d]"></div>

    <Image
      src={caseStudy}
      alt="Guest in a checked coat holding a dog at the Won Hundred AW25 show"
      class:list={[
        graphicClass,
        "left-[66.08%] top-[23.51%] h-[45.88%] w-[29.03%] rounded-[calc(8/900*100cqw)] object-cover",
      ]}
    />

    <p class="caption absolute left-[66.3222%] top-[70.4931%] m-0 whitespace-nowrap text-baseLight">
      CASE STUDY – WON HUNDRED AM25
    </p>

    <p class="copy absolute left-[66.3222%] top-[73.2347%] m-0 whitespace-nowrap text-baseLight">
      Curated audience of relevant fashion profiles for the<br />
      AW25 show - seamless execution with afterparty<br />
      access for premium engagement.
    </p>

    <p class="eyebrow absolute right-[4.0747%] top-[93.4876%] m-0 whitespace-nowrap">
      SOURCES: INDUSTRY INTERVIEWS, INTERNAL DATA
    </p>
  </section>
</div>
