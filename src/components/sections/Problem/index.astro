---
import { Image } from "astro:assets";
import caseStudy from "@/assets/problem/case-study.png";

interface Problem {
  index: string;
  title: string;
  lines: [string, string];
  ruleTop: string;
  indexTop: string;
  titleTop: string;
  bodyTop: string;
}

const problems: Problem[] = [
  {
    index: "01",
    title: "Fragmented partnerships.",
    lines: [
      "Collaborations are still managed through DMs, emails, and spreadsheets - creating slow",
      "execution and unnecessary friction.",
    ],
    ruleTop: "min-[1200px]:top-[46.9132%]",
    indexTop: "min-[1200px]:top-[49.5661%]",
    titleTop: "min-[1200px]:top-[48.9546%]",
    bodyTop: "min-[1200px]:top-[54.0039%]",
  },
  {
    index: "02",
    title: "Wrong audience.",
    lines: [
      "Brands often collaborate with profiles that lack true audience and brand alignment -",
      "eroding ROI.",
    ],
    ruleTop: "min-[1200px]:top-[61.4694%]",
    indexTop: "min-[1200px]:top-[64.7535%]",
    titleTop: "min-[1200px]:top-[64.142%]",
    bodyTop: "min-[1200px]:top-[69.211%]",
  },
  {
    index: "03",
    title: "No content strategy.",
    lines: [
      "Most collaborations happen without a clear performance or distribution strategy behind",
      "them.",
    ],
    ruleTop: "min-[1200px]:top-[76.075%]",
    indexTop: "min-[1200px]:top-[79.8619%]",
    titleTop: "min-[1200px]:top-[79.2899%]",
    bodyTop: "min-[1200px]:top-[84.2209%]",
  },
];
---

<div class="bg-baseLight min-[1200px]:grid min-[1200px]:h-dvh min-[1200px]:w-full min-[1200px]:place-items-center min-[1200px]:overflow-hidden min-[1200px]:[container-type:size]">
  <section
    class="bg-baseLight px-6 py-16 font-inter text-ink antialiased md:px-10 md:py-20 min-[1200px]:relative min-[1200px]:aspect-[900/507] min-[1200px]:w-[min(100cqw,calc(100cqh*1.775148))] min-[1200px]:overflow-hidden min-[1200px]:px-0 min-[1200px]:py-0 min-[1200px]:[container-type:size]"
    aria-label="The problem"
  >
    <div class="flex flex-col gap-8 min-[1200px]:contents">
      <p class="eyebrow m-0 min-[1200px]:absolute min-[1200px]:right-[4.0747%] min-[1200px]:top-[4.9312%] min-[1200px]:whitespace-nowrap">
        THE PROBLEM
      </p>

      <div class="flex flex-col gap-10 md:grid md:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] md:items-start md:gap-12 min-[1200px]:contents">
        <div class="flex min-w-0 flex-col gap-8 min-[1200px]:contents">
          <h2 class="headline-stack m-0 min-[1200px]:absolute min-[1200px]:left-[3.6444%] min-[1200px]:top-[12.6506%]">
            <span class="headline min-[1200px]:whitespace-nowrap">Premium brand</span>
            <span class="headline min-[1200px]:whitespace-nowrap">marketing needs</span>
            <span class="headline-italic min-[1200px]:whitespace-nowrap">a better way.</span>
          </h2>

          <div class="flex flex-col min-[1200px]:contents">
            {
              problems.map((problem) => (
                <article class="border-t border-baseLightGray py-5 min-[1200px]:contents">
                  <div
                    class:list={[
                      "hidden min-[1200px]:absolute min-[1200px]:left-[3.6444%] min-[1200px]:block min-[1200px]:h-[calc(1/900*100cqw)] min-[1200px]:w-[57.8333%] min-[1200px]:bg-baseLightGray",
                      problem.ruleTop,
                    ]}
                  />
                  <div class="flex gap-4 min-[1200px]:contents">
                    <p class:list={["caption m-0 w-8 shrink-0 text-ink min-[1200px]:absolute min-[1200px]:left-[4.4778%] min-[1200px]:w-auto min-[1200px]:whitespace-nowrap", problem.indexTop]}>
                      {problem.index}
                    </p>
                    <div class="min-w-0 min-[1200px]:contents">
                      <h3 class:list={["title m-0 min-[1200px]:absolute min-[1200px]:left-[9.3333%] min-[1200px]:whitespace-nowrap", problem.titleTop]}>
                        {problem.title}
                      </h3>
                      <p class:list={["copy m-0 mt-2 text-ink/80 min-[1200px]:absolute min-[1200px]:left-[9.3333%] min-[1200px]:mt-0 min-[1200px]:whitespace-nowrap", problem.bodyTop]}>
                        {problem.lines[0]}{" "}
                        <br class="hidden min-[1200px]:inline" />
                        {problem.lines[1]}
                      </p>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </div>

        <div class="flex flex-col gap-4 overflow-hidden rounded-[var(--radius-panel)] bg-panel p-4 text-baseLight md:p-6 min-[1200px]:absolute min-[1200px]:left-[63.8778%] min-[1200px]:top-[18.7377%] min-[1200px]:h-[70.8679%] min-[1200px]:w-[33.7444%] min-[1200px]:gap-0 min-[1200px]:p-0">
          <Image
            src={caseStudy}
            alt="Guest in a checked coat holding a dog at the Won Hundred AW25 show"
            class="pointer-events-none aspect-[4/5] w-full max-w-none rounded-[var(--radius-media)] object-cover min-[1200px]:absolute min-[1200px]:left-[6.53%] min-[1200px]:top-[6.73%] min-[1200px]:aspect-auto min-[1200px]:h-[64.74%] min-[1200px]:w-[86.03%]"
          />

          <p class="caption m-0 text-baseLight min-[1200px]:absolute min-[1200px]:left-[7.24%] min-[1200px]:top-[73.03%] min-[1200px]:whitespace-nowrap">
            CASE STUDY – WON HUNDRED AW25
          </p>

          <p class="copy m-0 text-baseLight min-[1200px]:absolute min-[1200px]:left-[7.24%] min-[1200px]:top-[76.9%] min-[1200px]:whitespace-nowrap">
            Curated audience of relevant fashion profiles for the
            <br class="hidden min-[1200px]:inline" />
            AW25 show - seamless execution with afterparty
            <br class="hidden min-[1200px]:inline" />
            access for premium engagement.
          </p>
        </div>
      </div>

      <p class="eyebrow m-0 min-[1200px]:absolute min-[1200px]:right-[4.0747%] min-[1200px]:top-[93.4876%] min-[1200px]:whitespace-nowrap">
        SOURCES: INDUSTRY INTERVIEWS, INTERNAL DATA
      </p>
    </div>
  </section>
</div>
