---
import { Image } from "astro:assets";
import photo from "@/assets/problem/case-study.png";
---

<div class="bg-canvasInk min-[1200px]:grid min-[1200px]:h-dvh min-[1200px]:w-full min-[1200px]:place-items-center min-[1200px]:overflow-hidden">
  <section
    class="bg-canvasInk px-6 py-16 font-inter text-paper antialiased md:px-10 md:py-20 min-[1200px]:relative min-[1200px]:h-[var(--board-h)] min-[1200px]:w-[var(--board-w)] min-[1200px]:overflow-hidden min-[1200px]:px-0 min-[1200px]:py-0 min-[1200px]:[container-type:inline-size]"
    aria-label="The show, then the room after"
  >
    <div class="flex flex-col gap-8 md:grid md:grid-cols-2 md:items-start md:gap-12 min-[1200px]:contents">
      <p class="eyebrow m-0 text-paper min-[1200px]:absolute min-[1200px]:right-[4.0747%] min-[1200px]:top-[4.931%] min-[1200px]:whitespace-nowrap">
        CASE STUDY • WON HUNDRED • AW25
      </p>

      <div class="order-1 flex min-w-0 flex-col gap-6 md:order-2 min-[1200px]:absolute min-[1200px]:left-[50%] min-[1200px]:top-[26%] min-[1200px]:order-none min-[1200px]:w-[45%] min-[1200px]:gap-5">
        <h2 class="headline-stack m-0">
          <span class="headline">The show,</span>
          <span class="headline-italic">then the room after.</span>
        </h2>

        <p class="body m-0 text-paper">
          A curated audience of relevant fashion profiles for the AW25 show, with afterparty access for the same guests.
        </p>

        <p class="body-muted m-0">
          The night ran as one plan, from the seat to the door.
        </p>
      </div>

      <div class="order-2 flex min-w-0 flex-col gap-4 md:order-1 min-[1200px]:contents">
        <Image
          src={photo}
          alt="Guest in a checked coat holding a dog at the Won Hundred AW25 show"
          class="pointer-events-none aspect-[4/5] w-full max-w-none object-cover object-center min-[1200px]:absolute min-[1200px]:left-[4.02%] min-[1200px]:top-[16.73%] min-[1200px]:aspect-auto min-[1200px]:h-[58%] min-[1200px]:w-[40%]"
        />

        <p class="caption m-0 text-paper/70 min-[1200px]:absolute min-[1200px]:left-[4.02%] min-[1200px]:top-[78%] min-[1200px]:whitespace-nowrap">
          WON HUNDRED AW25
        </p>
      </div>
    </div>
  </section>
</div>
