---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import rule1 from "@/assets/numbers/rule-1.png";
import rule2 from "@/assets/numbers/rule-2.png";
import rule3 from "@/assets/numbers/rule-3.png";
import rule4 from "@/assets/numbers/rule-4.png";

interface Stat {
  value: string;
  suffix: string;
  label: string;
  lines: string[];
  left: string;
  labelLeft: string;
  rule: ImageMetadata;
  ruleClass: string;
}

const stats: Stat[] = [
  {
    value: "36",
    suffix: "%",
    label: "of the biggest Danish influencers.",
    lines: [
      "More than a third of Denmark’s top",
      "profiles, available in one place - they",
      "come to you instead of the other way",
      "around.",
    ],
    left: "min-[1200px]:left-[4.267%]",
    labelLeft: "min-[1200px]:left-[4.267%]",
    rule: rule1,
    ruleClass: "min-[1200px]:left-[3.611%] min-[1200px]:top-[41.637%] min-[1200px]:h-[2.071%] min-[1200px]:w-[23%]",
  },
  {
    value: "11",
    suffix: "",
    label: "countries represented.",
    lines: [
      "Work with local and global influencers",
      "across 11 markets - no lengthy outreach",
      "or negotiations.",
    ],
    left: "min-[1200px]:left-[27.895%]",
    labelLeft: "min-[1200px]:left-[27.733%]",
    rule: rule2,
    ruleClass: "min-[1200px]:left-[26.533%] min-[1200px]:top-[41.637%] min-[1200px]:h-[2.071%] min-[1200px]:w-[24.167%]",
  },
  {
    value: "50",
    suffix: "K",
    label: "followers required.",
    lines: [
      "Every FORMA profile clears a 50K",
      "minimum and a quality review before",
      "joining - ensuring real reach and",
      "professionalism.",
    ],
    left: "min-[1200px]:left-[51.222%]",
    labelLeft: "min-[1200px]:left-[51.222%]",
    rule: rule3,
    ruleClass: "min-[1200px]:left-[50.633%] min-[1200px]:top-[41.637%] min-[1200px]:h-[2.071%] min-[1200px]:w-[22.922%]",
  },
  {
    value: "14",
    suffix: "M",
    label: "total reach.",
    lines: [
      "Combined reach across fashion,",
      "hospitality, and culture - and growing",
      "every cohort.",
    ],
    left: "min-[1200px]:left-[74.821%]",
    labelLeft: "min-[1200px]:left-[74.611%]",
    rule: rule4,
    ruleClass: "min-[1200px]:left-[73.522%] min-[1200px]:top-[41.637%] min-[1200px]:h-[2.071%] min-[1200px]:w-[24.167%]",
  },
];
---

<div class="bg-baseLight min-[1200px]:grid min-[1200px]:h-dvh min-[1200px]:w-full min-[1200px]:place-items-center min-[1200px]:overflow-hidden min-[1200px]:[container-type:size]">
  <section
    class="bg-baseLight px-6 py-16 font-inter text-ink antialiased md:px-10 md:py-20 min-[1200px]:relative min-[1200px]:aspect-[900/507] min-[1200px]:w-[min(100cqw,calc(100cqh*1.775148))] min-[1200px]:overflow-hidden min-[1200px]:px-0 min-[1200px]:py-0 min-[1200px]:[container-type:size]"
    aria-label="By the numbers"
  >
    <div class="flex flex-col gap-8 min-[1200px]:contents">
      <p class="eyebrow m-0 min-[1200px]:absolute min-[1200px]:right-[2.822%] min-[1200px]:top-[4.398%] min-[1200px]:whitespace-nowrap">
        BY THE NUMBERS
      </p>

      <p class="deck m-0 max-w-sm min-[1200px]:absolute min-[1200px]:right-[2.744%] min-[1200px]:top-[11.361%] min-[1200px]:max-w-none min-[1200px]:text-right">
        Concentrated reach across the markets
        <br class="hidden min-[1200px]:inline" />
        premium brands actually want.
      </p>

      <h2 class="headline-row m-0 min-[1200px]:absolute min-[1200px]:left-[4.02%] min-[1200px]:top-[29.8%] min-[1200px]:whitespace-nowrap">
        <span class="headline">Real</span>
        <span class="sr-only"> </span>
        <span class="headline-italic">momentum.</span>
      </h2>

      <div class="grid grid-cols-1 gap-10 md:grid-cols-2 min-[1200px]:contents">
        {
          stats.map((stat) => (
            <article class="flex flex-col gap-3 border-t border-baseLightGray pt-4 min-[1200px]:contents min-[1200px]:border-0 min-[1200px]:pt-0">
              <Image
                src={stat.rule}
                alt=""
                class:list={["pointer-events-none w-full object-fill max-[1199px]:h-2 min-[1200px]:absolute min-[1200px]:max-w-none", stat.ruleClass]}
              />
              <p class:list={["stat m-0 min-[1200px]:absolute min-[1200px]:top-[44.181%] min-[1200px]:whitespace-nowrap", stat.left]}>
                {stat.value}{stat.suffix && <span class="stat-suffix">{stat.suffix}</span>}
              </p>
              <p class:list={["stat-label m-0 min-[1200px]:absolute min-[1200px]:top-[58.422%] min-[1200px]:whitespace-nowrap", stat.labelLeft]}>
                {stat.label}
              </p>
              <p class:list={["stat-note m-0 min-[1200px]:absolute min-[1200px]:top-[62.13%] min-[1200px]:whitespace-nowrap", stat.labelLeft]}>
                {stat.lines.map((line, index) => (
                  <>
                    {index > 0 && " "}
                    {index > 0 && <br class="hidden min-[1200px]:inline" />}
                    {line}
                  </>
                ))}
              </p>
            </article>
          ))
        }
      </div>

      <p class="eyebrow m-0 min-[1200px]:absolute min-[1200px]:right-[2.44%] min-[1200px]:top-[93.77%] min-[1200px]:whitespace-nowrap">
        NETWORK AS OF Q2 2026
      </p>
    </div>
  </section>
</div>
