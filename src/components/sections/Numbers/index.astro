---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import rule1 from "@/assets/numbers/rule-1.png";
import rule2 from "@/assets/numbers/rule-2.png";
import rule3 from "@/assets/numbers/rule-3.png";
import rule4 from "@/assets/numbers/rule-4.png";

interface Stat {
  value: string;
  suffix: string;
  tracking: string;
  valueTop: string;
  label: string;
  lines: string[];
  left: string;
  labelLeft: string;
  suffixLeft: string;
  suffixTop: string;
  rule: ImageMetadata;
  ruleClass: string;
}

const graphicClass = "pointer-events-none absolute max-w-none";

const stats: Stat[] = [
  {
    value: "36",
    suffix: "%",
    tracking: "tracking-[-0.03125em]",
    valueTop: "top-[44.181%]",
    label: "of the biggest Danish influencers.",
    lines: [
      "More than a third of Denmark’s top",
      "profiles, available in one place - they",
      "come to you instead of the other way",
      "around.",
    ],
    left: "left-[4.267%]",
    labelLeft: "left-[4.267%]",
    suffixLeft: "left-[12.056%]",
    suffixTop: "top-[49.507%]",
    rule: rule1,
    ruleClass: "left-[3.611%] top-[41.637%] h-[2.071%] w-[23%]",
  },
  {
    value: "11",
    suffix: "",
    tracking: "tracking-[0.297em]",
    valueTop: "top-[43.59%]",
    label: "countries represented.",
    lines: [
      "Work with local and global influencers",
      "across 11 markets - no lengthy outreach",
      "or negotiations.",
    ],
    left: "left-[27.01%]",
    labelLeft: "left-[27.733%]",
    suffixLeft: "",
    suffixTop: "",
    rule: rule2,
    ruleClass: "left-[26.533%] top-[41.637%] h-[2.071%] w-[24.167%]",
  },
  {
    value: "50",
    suffix: "K",
    tracking: "tracking-[-0.0156em]",
    valueTop: "top-[44.181%]",
    label: "followers required.",
    lines: [
      "Every FORMA profile clears a 50K",
      "minimum and a quality review before",
      "joining - ensuring real reach and",
      "professionalism.",
    ],
    left: "left-[51.222%]",
    labelLeft: "left-[51.222%]",
    suffixLeft: "left-[58.878%]",
    suffixTop: "top-[49.901%]",
    rule: rule3,
    ruleClass: "left-[50.633%] top-[41.637%] h-[2.071%] w-[22.922%]",
  },
  {
    value: "14",
    suffix: "M",
    tracking: "tracking-[0.125em]",
    valueTop: "top-[43.59%]",
    label: "total reach.",
    lines: [
      "Combined reach across fashion,",
      "hospitality, and culture - and growing",
      "every cohort.",
    ],
    left: "left-[73.52%]",
    labelLeft: "left-[74.611%]",
    suffixLeft: "left-[81.6%]",
    suffixTop: "top-[50.099%]",
    rule: rule4,
    ruleClass: "left-[73.522%] top-[41.637%] h-[2.071%] w-[24.167%]",
  },
];
---

<div class="grid h-dvh w-full place-items-center overflow-hidden bg-baseLight [container-type:size]">
  <section
    class="relative aspect-[900/507] w-[min(100cqw,calc(100cqh*1.775148))] overflow-hidden bg-baseLight font-inter text-ink antialiased [container-type:size]"
    aria-label="By the numbers"
  >
    <p class="eyebrow absolute right-[2.822%] top-[4.398%] m-0 whitespace-nowrap">
      BY THE NUMBERS
    </p>

    <p class="deck absolute right-[2.744%] top-[11.361%] m-0 text-right">
      Concentrated reach across the markets
      <br />
      premium brands actually want.
    </p>

    <h2 class="m-0">
      <span class="headline absolute left-[4.02%] top-[29.8%] m-0 whitespace-nowrap">Real</span>
      <span class="headline-italic absolute left-[14.81%] top-[29.99%] m-0 whitespace-nowrap">momentum</span>
    </h2>

    {
      stats.map((stat) => (
        <>
          <Image src={stat.rule} alt="" class:list={[graphicClass, "object-fill", stat.ruleClass]} />
          <p class:list={["stat absolute m-0 whitespace-nowrap", stat.valueTop, stat.left, stat.tracking]}>
            {stat.value}
          </p>
          {stat.suffix && (
            <p class:list={["stat-suffix absolute m-0 whitespace-nowrap", stat.suffixTop, stat.suffixLeft]}>
              {stat.suffix}
            </p>
          )}
          <p class:list={["stat-label absolute top-[58.422%] m-0 whitespace-nowrap", stat.labelLeft]}>
            {stat.label}
          </p>
          <p class:list={["stat-note absolute top-[62.13%] m-0 whitespace-nowrap", stat.labelLeft]}>
            {stat.lines.map((line) => (
              <>
                {line}
                <br />
              </>
            ))}
          </p>
        </>
      ))
    }

    <p class="eyebrow absolute right-[2.44%] top-[93.77%] m-0 whitespace-nowrap">
      NETWORK AS OF Q2 2026
    </p>
  </section>
</div>
