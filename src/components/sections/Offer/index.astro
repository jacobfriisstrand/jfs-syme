---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import partnerships from "@/assets/offer/partnerships.png";
import matching from "@/assets/offer/matching.png";
import execution from "@/assets/offer/execution.png";

interface Offer {
  index: string;
  title: string;
  lines: string[];
  icon: ImageMetadata;
  iconClass: string;
  left: string;
  titleTop: string;
  bodyTop: string;
}

const graphicClass = "pointer-events-none absolute max-w-none";

const offers: Offer[] = [
  {
    index: "01 - PARTNERSHIPS",
    title: "Launch curated\ncollaborations.",
    lines: [
      "Send experiences directly to a handpicked",
      "network of pre-vetted premium profiles -",
      "ensuring quality, relevance, and stronger brand",
      "positioning from the start.",
    ],
    icon: partnerships,
    iconClass: "left-[4.822%] top-[52.051%] h-[8.422%] w-[4.833%]",
    left: "left-[5.678%]",
    titleTop: "top-[65.7%]",
    bodyTop: "top-[76.03%]",
  },
  {
    index: "02 - PROFILE MATCHING",
    title: "Aligned by data & aesthetic.",
    lines: [
      "Profiles are carefully matched on audience",
      "demographics, content style, aesthetics,",
      "engagement, and brand alignment to create",
      "authentic, high-performing partnerships.",
    ],
    icon: matching,
    iconClass: "left-[36.233%] top-[52.051%] h-[8.422%] w-[3.667%]",
    left: "left-[36.722%]",
    titleTop: "top-[65.759%]",
    bodyTop: "top-[72.23%]",
  },
  {
    index: "03 - UNIFIED EXECUTION",
    title: "One platform, end to end.",
    lines: [
      "Manage the full flow - outreach, confirmations,",
      "content delivery, communication, and performance",
      "tracking - without ever leaving the workspace.",
    ],
    icon: execution,
    iconClass: "left-[66.456%] top-[52.051%] h-[8.422%] w-[4.833%]",
    left: "left-[67.789%]",
    titleTop: "top-[65.759%]",
    bodyTop: "top-[72.23%]",
  },
];
---

<div class="grid h-dvh w-full place-items-center overflow-hidden bg-baseLight [container-type:size]">
  <section
    class="relative aspect-[900/507] w-[min(100cqw,calc(100cqh*1.775148))] overflow-hidden bg-baseLight font-inter text-ink antialiased [container-type:size]"
    aria-label="What we offer"
  >
    <p class="eyebrow absolute right-[2.822%] top-[4.398%] m-0 whitespace-nowrap">
      WHAT WE OFFER
    </p>

    <p class="deck absolute right-[2.744%] top-[11.361%] m-0 w-[20.056%] text-right">
      One platform from outreach to
      <br />
      performance - replacing inboxes,
      <br />
      spreadsheets, and unmatched lists.
    </p>

    <h2 class="m-0">
      <span class="headline absolute left-[3.92%] top-[24.55%] whitespace-nowrap">Built to remove friction from</span>
      <span class="headline-italic absolute left-[4.02%] top-[35.41%] whitespace-nowrap">premium collaborations</span>
    </h2>

    <div class="absolute left-[3.6%] top-[47.889%] h-[calc(1/900*100cqw)] w-[94.333%] bg-baseLightGray"></div>
    <div class="absolute left-[34.444%] top-[47.889%] h-[39.645%] w-[calc(1/900*100cqw)] -translate-x-1/2 bg-baseLightGray"></div>
    <div class="absolute left-[65.856%] top-[47.889%] h-[39.645%] w-[calc(1/900*100cqw)] -translate-x-1/2 bg-baseLightGray"></div>

    {
      offers.map((offer) => (
        <>
          <Image
            src={offer.icon}
            alt=""
            class:list={[graphicClass, "object-contain object-left", offer.iconClass]}
          />
          <p
            class:list={[
              "caption absolute top-[62.387%] m-0 whitespace-nowrap text-ink",
              offer.left,
            ]}
          >
            {offer.index}
          </p>
          <h3
            class:list={[
              "title absolute m-0 whitespace-pre",
              offer.left,
              offer.titleTop,
            ]}
          >
            {offer.title}
          </h3>
          <p
            class:list={[
              "copy absolute m-0 whitespace-nowrap text-ink",
              offer.left,
              offer.bodyTop,
            ]}
          >
            {offer.lines.map((line) => (
              <>
                {line}
                <br />
              </>
            ))}
          </p>
        </>
      ))
    }

    <p class="eyebrow absolute right-[2%] top-[94.241%] m-0 whitespace-nowrap">
      REPLACES: DMS - EMAIL - SHEETS - 3RD PARTY TRACKERS
    </p>
  </section>
</div>
