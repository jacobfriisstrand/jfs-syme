---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import radisson from "@/assets/partners/radisson.png";
import wonHundred from "@/assets/partners/won-hundred.png";
import nrd55 from "@/assets/partners/nrd55.png";
import vernon from "@/assets/partners/vernon.png";
import lucieKaas from "@/assets/partners/lucie-kaas.png";
import babylon from "@/assets/partners/babylon.png";
import camilleBrinch from "@/assets/partners/camille-brinch.svg";
import sopavillonen from "@/assets/partners/sopavillonen.svg";
import theMoment from "@/assets/partners/the-moment.svg";
import aura from "@/assets/partners/aura.svg";
import darling from "@/assets/partners/darling.svg";
import arneAksel from "@/assets/partners/arne-aksel.svg";
import woods from "@/assets/partners/woods.svg";
import visitDenmark from "@/assets/partners/visit-denmark.svg";

interface PartnerLogo {
  src: ImageMetadata;
  alt: string;
  class: string;
}

const rowOne: Array<PartnerLogo | "issei"> = [
  { src: radisson, alt: "Radisson Collection", class: "w-[max(4.75rem,10.16cqw)]" },
  { src: wonHundred, alt: "Won Hundred", class: "w-[max(5rem,10.58cqw)]" },
  { src: nrd55, alt: "NRD55", class: "w-[max(3.25rem,6.58cqw)]" },
  { src: vernon, alt: "Vernon", class: "w-[max(4.25rem,8.75cqw)]" },
  "issei",
];

const rowTwo: PartnerLogo[] = [
  { src: camilleBrinch, alt: "Camille Brinch", class: "w-[max(6rem,12.75cqw)]" },
  { src: sopavillonen, alt: "Søpavillonen", class: "w-[max(6.25rem,13.58cqw)]" },
  { src: theMoment, alt: "The Moment", class: "w-[max(5.25rem,11.08cqw)]" },
  { src: arneAksel, alt: "Arne Aksel", class: "w-[max(3.5rem,6.83cqw)]" },
  { src: darling, alt: "Darling", class: "w-[max(4.25rem,8.83cqw)]" },
];

const rowThree: PartnerLogo[] = [
  { src: lucieKaas, alt: "Lucie Kaas", class: "w-[max(4.75rem,10cqw)]" },
  { src: aura, alt: "Aura", class: "w-[max(5.75rem,12.42cqw)]" },
  { src: woods, alt: "woods", class: "w-[max(4.25rem,8.83cqw)]" },
  { src: babylon, alt: "Babylon", class: "w-[max(1.5rem,3.08cqw)]" },
  { src: visitDenmark, alt: "VisitDenmark", class: "w-[max(6rem,12.58cqw)]" },
];

const rows = [rowOne, rowTwo, rowThree];
const motions = ["animate-marquee", "animate-marquee-mid", "animate-marquee-slow"];

const logoClass = "h-auto max-w-none shrink-0 object-contain";
---

<div class="w-full overflow-x-clip bg-baseLight">
  <section
    class="flex flex-col gap-10 bg-baseLight px-6 py-16 font-inter text-ink antialiased md:px-10 md:py-20 min-[1200px]:relative min-[1200px]:mx-auto min-[1200px]:aspect-[900/363] min-[1200px]:w-[var(--board-w)] min-[1200px]:gap-0 min-[1200px]:px-0 min-[1200px]:py-0 min-[1200px]:[container-type:size]"
    aria-label="Partners"
  >
    <h2 class="sr-only">Partners, at a glance.</h2>

    <div aria-hidden="true" class="headline-stack m-0 min-[1200px]:absolute min-[1200px]:left-[4.41%] min-[1200px]:top-[13.22%]">
      <p class="headline m-0 min-[1200px]:whitespace-nowrap">Partners,</p>
      <p class="headline-italic m-0 min-[1200px]:whitespace-nowrap">at a glance.</p>
    </div>

    <div class="flex w-screen -translate-x-0 flex-col gap-5 max-[1199px]:relative max-[1199px]:left-1/2 max-[1199px]:-translate-x-1/2 min-[1200px]:absolute min-[1200px]:left-1/2 min-[1200px]:top-[49.48%] min-[1200px]:w-screen min-[1200px]:-translate-x-1/2 min-[1200px]:gap-[calc(18/900*100cqw)]">
      {
        rows.map((row, rowIndex) => (
          <div class="overflow-hidden">
            <div class:list={["flex w-max motion-reduce:animate-none", motions[rowIndex]]}>
              {[false, true].map((hidden) =>
                [0, 1, 2].map((copy) => (
                  <div class="flex shrink-0 items-center gap-6 pr-6 min-[1200px]:gap-[4.5cqw] min-[1200px]:pr-[4.5cqw]" aria-hidden={hidden || copy > 0 || undefined}>
                    {row.map((partner) =>
                      partner === "issei" ? (
                        <p class="logo-word m-0 shrink-0">
                          ISSEI
                        </p>
                      ) : (
                        <Image src={partner.src} alt={hidden || copy > 0 ? "" : partner.alt} class:list={[logoClass, partner.class]} />
                      ),
                    )}
                  </div>
                )),
              )}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</div>
