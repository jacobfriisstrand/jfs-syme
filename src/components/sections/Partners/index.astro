---
import { Image } from "astro:assets";
import { partnerRows } from "@/components/sections/Partners/logos";

const rows = partnerRows;
const motions = ["animate-marquee", "animate-marquee-mid", "animate-marquee-slow"];

const logoClass = "max-w-none shrink-0 object-contain";
---

<div class="w-full overflow-x-clip bg-baseLight">
  <section
    class="flex flex-col gap-10 bg-baseLight px-6 py-16 font-inter text-ink antialiased md:px-10 md:py-20 min-[1200px]:relative min-[1200px]:mx-auto min-[1200px]:h-[calc(var(--board-w)*363/900)] min-[1200px]:w-[var(--board-w)] min-[1200px]:gap-0 min-[1200px]:px-0 min-[1200px]:py-0 min-[1200px]:[container-type:inline-size]"
    aria-label="Partners"
  >
    <h2 class="sr-only">Partners, at a glance.</h2>

    <div aria-hidden="true" class="headline-stack m-0 min-[1200px]:absolute min-[1200px]:left-[4.41%] min-[1200px]:top-[13.22%]">
      <p class="headline m-0 min-[1200px]:whitespace-nowrap">Partners,</p>
      <p class="headline-italic m-0 min-[1200px]:whitespace-nowrap">at a glance.</p>
    </div>

    <div class="flex w-screen -translate-x-0 flex-col gap-5 max-[1199px]:relative max-[1199px]:left-1/2 max-[1199px]:-translate-x-1/2 min-[1200px]:absolute min-[1200px]:left-1/2 min-[1200px]:top-[49.48%] min-[1200px]:w-screen min-[1200px]:-translate-x-1/2 min-[1200px]:gap-[calc(18*var(--board-w)/900)]">
      {
        rows.map((row, rowIndex) => (
          <div class="overflow-hidden">
            <div class:list={["flex w-max motion-reduce:animate-none", motions[rowIndex]]}>
              {[false, true].map((hidden) =>
                [0, 1, 2].map((copy) => (
                  <div class="flex shrink-0 items-center gap-6 pr-6 min-[1200px]:gap-[calc(var(--board-w)*0.045)] min-[1200px]:pr-[calc(var(--board-w)*0.045)]" aria-hidden={hidden || copy > 0 || undefined}>
                    {row.map((partner) =>
                      partner === "issei" ? (
                        <p class="logo-word m-0 shrink-0">
                          ISSEI
                        </p>
                      ) : (
                        <Image src={partner.src} alt={hidden || copy > 0 ? "" : partner.alt} class:list={[logoClass, partner.class]} />
                      ),
                    )}
                  </div>
                )),
              )}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</div>
