---
import { Image } from "astro:assets";
import logo from "@/assets/forma-logo.png";

const marks = [
  { place: "right-[6%] top-[18%] w-24 md:w-32", delay: "0s" },
  { place: "left-[4%] top-[30%] w-24 md:w-28", delay: "6s" },
  { place: "right-[14%] top-[44%] w-32 md:w-40", delay: "11s" },
  { place: "left-[42%] top-[58%] w-28 md:w-36", delay: "3s" },
  { place: "right-[5%] top-[72%] w-24 md:w-32", delay: "14s" },
  { place: "left-[16%] top-[86%] w-28 md:w-36", delay: "8s" },
];
---

<div class="pointer-events-none absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
  {
    marks.map((mark) => (
      <Image
        src={logo}
        alt=""
        loading="eager"
        class:list={["absolute h-auto object-contain brightness-0 invert opacity-10 motion-safe:animate-field-breathe", mark.place]}
        style={`animation-delay: ${mark.delay}`}
      />
    ))
  }
</div>
