---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ruleCreate from "@/assets/web/rule-create.png";
import ruleRest from "@/assets/web/rule-rest.png";
import windowChrome from "@/assets/web/window-chrome.png";
import windowBody from "@/assets/web/window-body.png";
import dotRed from "@/assets/web/dot-red.svg?url";
import dotMid from "@/assets/web/dot-mid.svg?url";
import dotGreen from "@/assets/web/dot-green.svg?url";

interface Rule {
  src: ImageMetadata;
  class: string;
}

interface Column {
  label: string;
  title: string;
  lines: [string, string];
  left: string;
  bodyTop: string;
}

interface Dot {
  src: string;
  width: number;
  height: number;
  class: string;
}

const graphicClass = "pointer-events-none absolute max-w-none";

const rules: Rule[] = [
  { src: ruleCreate, class: "left-[3.6557%] top-[35.406%] h-[2.0711%] w-[30.3348%]" },
  { src: ruleRest, class: "left-[35.1017%] top-[35.406%] h-[2.0711%] w-[30.3348%]" },
  { src: ruleRest, class: "left-[66.6698%] top-[35.406%] h-[2.0711%] w-[30.3348%]" },
];

const columns: Column[] = [
  {
    label: "01 - CREATE",
    title: "Curated offers in minutes.",
    lines: ["Create your account and launch tailored collaboration", "offers without leaving the workspace."],
    left: "left-[4.1113%]",
    bodyTop: "top-[45.27%]",
  },
  {
    label: "02 - CONTROL",
    title: "Approve the right profiles.",
    lines: ["Upload offers, review matched applicants, and approve the", "right talent in a few clicks."],
    left: "left-[35.7128%]",
    bodyTop: "top-[45.21%]",
  },
  {
    label: "03 - MEASURE",
    title: "Track every story.",
    lines: ["Monitor stories, posts, reach, and performance live - every", "deliverable in one ledger."],
    left: "left-[67.3143%]",
    bodyTop: "top-[45.21%]",
  },
];

const dots: Dot[] = [
  { src: dotRed, width: 7.7, height: 7.5, class: "left-[4.96%] top-[55.52%] h-[1.48%] w-[0.85%] rounded-full" },
  { src: dotMid, width: 7.4, height: 7.5, class: "left-[6.19%] top-[55.66%] h-[1.48%] w-[0.82%] rounded-full" },
  { src: dotGreen, width: 7.5, height: 7.5, class: "left-[7.41%] top-[55.66%] h-[1.48%] w-[0.83%] rounded-full" },
];
---

<div class="grid h-dvh w-full place-items-center overflow-hidden bg-baseLight [container-type:size]">
  <section
    class="relative aspect-[900/507] w-[min(100cqw,calc(100cqh*1.775148))] overflow-hidden bg-baseLight font-inter text-ink antialiased [container-type:size]"
    aria-label="Forma on web"
  >
    {
      rules.map((rule) => (
        <Image src={rule.src} alt="" class:list={[graphicClass, "object-fill", rule.class]} />
      ))
    }

    <Image
      src={windowChrome}
      alt=""
      class:list={[graphicClass, "left-[3.6557%] top-[52.0537%] h-[6.3514%] w-[94.4156%] object-fill"]}
    />
    <Image
      src={windowBody}
      alt="Forma workspace overview with offer notifications"
      class:list={[graphicClass, "left-[4.2113%] top-[57.8726%] h-[32.0922%] w-[92.9933%] object-fill"]}
    />

    {
      dots.map((dot) => (
        <img src={dot.src} alt="" width={dot.width} height={dot.height} class:list={[graphicClass, "object-fill", dot.class]} />
      ))
    }

    <p class="eyebrow absolute right-[4.0747%] top-[4.9312%] m-0 whitespace-nowrap">
      PRODUCT - WEB
    </p>

    <h2 class="m-0">
      <span class="headline absolute left-[3.66%] top-[14.79%] m-0 whitespace-nowrap">FORMA</span>
      <span class="headline-italic absolute left-[3.66%] top-[25.05%] m-0 whitespace-nowrap">on web</span>
    </h2>

    <p class="deck absolute right-[2.7397%] top-[11.3615%] m-0 w-[22.7789%] text-right">
      Launch, manage, and track premium<br />
      collaborations from one workspace built<br />
      for brand teams.
    </p>

    {
      columns.map((column) => (
        <>
          <p class:list={["absolute top-[38.5423%] m-0 whitespace-nowrap font-plex text-[length:calc(6.4/900*100cqw)] font-normal leading-none tracking-[0.09em] text-[#000]", column.left]}>
            {column.label}
          </p>
          <p class:list={["absolute top-[41.4221%] m-0 whitespace-nowrap text-[length:calc(12.4/900*100cqw)] font-semibold leading-[1.21] tracking-[-0.0117em] text-[#000]", column.left]}>
            {column.title}
          </p>
          <p class:list={["absolute m-0 whitespace-nowrap text-[length:calc(9.5/900*100cqw)] font-normal leading-[1.16] tracking-[-0.01em] text-[#4d4b4b]", column.left, column.bodyTop]}>
            {column.lines[0]}
            <br />
            {column.lines[1]}
          </p>
        </>
      ))
    }

    <p class="absolute left-[9.4893%] top-[55.5845%] m-0 whitespace-nowrap font-plex text-[length:calc(5/900*100cqw)] font-normal leading-none tracking-[0.03em] text-[#4d4b4b]">
      form app / brand / collabostions
    </p>

    <p class="eyebrow absolute right-[4.0747%] top-[93.4876%] m-0 whitespace-nowrap">
      member.formaintl.com
    </p>
  </section>
</div>
