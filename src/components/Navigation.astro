---
import { fetchData } from "../lib/fetchData";
import Image from "astro/components/Image.astro";
import BiSendFill from "@/icons/BiSendFill.svg?raw";

interface FetchedData {
  logo: {
    logo: {
      alt: string;
      url: string;
      width: number;
      height: number;
    };
  };

  contact: {
    companyName: string;
    contactLinkName: string;
    contactEmail: string;
    pressLinkName: string;
    pressEmail: string;
  };
}
const data: FetchedData = await fetchData<FetchedData>(`{
  logo: generalInfo {
    logo {
      alt
      url
      width
      height
    }
  }

   contact: generalInfo {
    companyName
    contactLinkName
    contactEmail
    pressLinkName
    pressEmail
  }

}`);
---

<header class="sticky top-0 z-10 w-full min-w-0 bg-baseLight bg-opacity-50 backdrop-blur">
  <nav class="w-full border-b border-b-baseLightGray py-3 md:py-4 px-6">
    <ul class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 [&>a]:hover:text-baseLightGray">
      <li class="min-w-0">
        <a class="flex min-w-0 gap-2 items-center text-lg font-semibold md:text-2xl" aria-label="Home" href="/"
          ><Image loading={"eager"} class="size-[1em] shrink-0" src={data.logo.logo.url} alt={data.logo.logo.alt} width={data.logo.logo.width} height={data.logo.logo.height} /><span class="min-w-0">{data.contact.companyName.split("").join(" ")}</span></a
        >
      </li>
      <div class="flex flex-wrap gap-4 md:gap-10 text-sm md:text-base">
        <li>
          <a class="flex group gap-2 items-center" aria-label={data.contact.pressLinkName} href={`mailto:${data.contact.pressEmail}`}
            >{data.contact.pressLinkName}<span class="flex size-[1em] opacity-0 ease-in-out transition-all group-hover:opacity-100 group-hover:translate-x-1 group-focus:opacity-100 group-focus:translate-x-2" set:html={BiSendFill} /></a
          >
        </li>
        <li>
          <a class="flex group gap-2 items-center transition-all" aria-label={data.contact.contactLinkName} href={`mailto:${data.contact.contactEmail}`}
            >{data.contact.contactLinkName} <span class="flex size-[1em] opacity-0 ease-in-out transition-all group-hover:opacity-100 group-hover:translate-x-1 group-focus:opacity-100 group-focus:translate-x-2" set:html={BiSendFill} /></a
          >
        </li>
      </div>
    </ul>
  </nav>
</header>
